# IMPORTANT: After installing new packages with 'pipenv install <package>',
# regenerate requirements.txt for Docker builds by running:
# pipenv requirements > requirements.txt

[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
build = "*"
pydantic = "*"
pdoc = "*"
numpy = "*"
scikit-learn = "*"
pandas = "*"
fastapi = "*"
uvicorn = {extras = ["standard"], version = "*"}
sqlalchemy = "*"
pymysql = "*"
python-dotenv = "*"
pydantic-settings = "*"
cryptography = "*"
python-json-logger = "*"
pydecision = "*"

[dev-packages]
pytest = "*"
ipykernel = "*"
httpx = "*"

[requires]
python_version = "3.13"
