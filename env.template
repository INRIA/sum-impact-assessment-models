# ─────────────────────────────────────────────────────────────
# SUM Impact Assessment API — environment template
# Copy this file to `.env` and fill in the values:
#   cp env.template .env
# ─────────────────────────────────────────────────────────────

# Application environment.
# Options: development, preproduction, production
# NOTE: simulation endpoints are DISABLED when ENV=production
ENV=development

# Database (shared dev DB credentials are provided by the team — do NOT commit real values)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=sum_odp

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=SUM Impact Assessment API
API_VERSION=0.1.0

# Logging
# LOG_LEVEL options: CRITICAL, FATAL, ERROR, WARN, WARNING, INFO, DEBUG, NOTSET
# LOG_FORMAT options: json, console
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# API keys — generate with: openssl rand -base64 32
# INTERNAL_API_KEY      protects /kpis, /jobs and /simulation endpoints
# ADMIN_REFRESH_API_KEY protects the admin full-refresh endpoints
INTERNAL_API_KEY=xxx
ADMIN_REFRESH_API_KEY=xxx

# IPs allowed to call the admin full-refresh endpoints (JSON list)
ADMIN_REFRESH_ALLOWED_IPS=["10.0.0.1"]
